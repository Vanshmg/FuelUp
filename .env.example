# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit your real key.

# Optional. Without it, FuelUp runs on built-in demo data and fallback plans.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (see src/lib/config.ts).
# GEMINI_MODEL=
